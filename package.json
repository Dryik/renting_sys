{
  "name": "arak-rental-desk",
  "version": "0.3.9",
  "description": "ARAK Rental Desk desktop product for small car and motorcycle rental shops.",
  "author": "ARAK Communication & IT Services",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "license:app": "electron scripts/generate-license-app.mjs",
    "capture:visual-qa": "node scripts/capture-visual-qa.mjs",
    "perf:stress": "electron scripts/perf-stress.cjs",
    "qa:contract-print": "npm run build && electron out/main/contract-print-smoke.js",
    "clean:release": "node scripts/clean-release.mjs",
    "build": "npm run typecheck && electron-vite build",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "npm run clean:release && npm run build && electron-builder"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.8",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "ly.arak.rentaldesk",
    "productName": "ARAK Rental Desk",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dryik",
        "repo": "renting_sys"
      }
    ],
    "files": [
      "out/**/*",
      "!out/main/contract-print-smoke.js",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "license": "build/license.txt",
      "oneClick": true,
      "perMachine": false,
      "differentialPackage": true
    },
    "artifactName": "ARAK-Rental-Desk-Setup-${version}.${ext}"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
